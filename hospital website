<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CarePlus Hospital</title>

    <link rel="stylesheet" href="css.style">
</head>

<body>

    <!-- Navigation -->

    <nav>
        <div class="logo">
            CarePlus Hospital
        </div>

        <div class="nav-links">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#departments">Departments</a>
            <a href="#doctors">Doctors</a>
            <a href="#services">Services</a>
            <a href="#appointment">Appointment</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>


    <!-- Home -->

    <section id="home">

        <div class="hospital-highlights">

    <div>
        <strong>24/7</strong>
        <span>Emergency Care</span>
    </div>

    <div>
        <strong>Expert</strong>
        <span>Medical Team</span>
    </div>

    <div>
        <strong>Modern</strong>
        <span>Facilities</span>
    </div>

</div>

            <div class="hero-text">

                <p class="welcome">
                    YOUR HEALTH, OUR PRIORITY
                </p>

                <h1>
                    Quality Healthcare<br>
                    You Can Trust
                </h1>

                <p>
                    Compassionate care, experienced doctors,
                    and modern medical facilities for you and
                    your family.
                </p>

                <div class="hero-buttons">

                    <a href="#appointment">
                        Book an Appointment
                    </a>

                    <a href="#departments" class="secondary-btn">
                        Explore Departments
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- About -->

    <section id="about">

        <h2>About CarePlus Hospital</h2>

        <p class="section-intro">
            CarePlus Hospital is committed to providing
            quality healthcare with compassion, professionalism,
            and modern medical facilities.
        </p>

    </section>


    <!-- Departments -->

    <section id="departments">

        <h2>Our Departments</h2>

        <p class="section-intro">
            Comprehensive medical care under one roof.
        </p>

        <div class="cards-container">

            <div class="card">
<div class="department-icon">♥</div>
                <h3>Cardiology</h3>
                <p>
                    Comprehensive care for heart and
                    cardiovascular conditions.
                </p>
            </div>

            <div class="card">
               <div class="department-icon">🧠</div> <h3>Neurology</h3>
                <p>
                    Specialized diagnosis and treatment
                    for neurological conditions.
                </p>
            </div>

            <div class="card">
                <div class="department-icon">🦴</div>
<h3>Orthopedics</h3>
                <p>
                    Expert care for bones, joints,
                    muscles, and movement.
                </p>
            </div>

            <div class="card">
               <div class="department-icon">👶</div> <h3>Pediatrics</h3>
                <p>
                    Dedicated healthcare for infants,
                    children, and teenagers.
                </p>
            </div>

        </div>

    </section>


    <!-- Doctors -->

    <section id="doctors">

        <h2>Our Doctors</h2>

        <p class="section-intro">
            Experienced professionals dedicated to your care.
        </p>

        <div class="cards-container">

            <div class="doctor-card">

                <div class="doctor-photo">
                    DR
                </div>

                <h3>Dr. Sarah Sharma</h3>

                <p>
                    Cardiologist
                </p>

            </div>


            <div class="doctor-card">

                <div class="doctor-photo">
                    DR
                </div>

                <h3>Dr. Rahul Mehta</h3>

                <p>
                    Neurologist
                </p>

            </div>


            <div class="doctor-card">

                <div class="doctor-photo">
                    DR
                </div>

                <h3>Dr. Priya Kapoor</h3>

                <p>
                    Pediatrician
                </p>

            </div>

        </div>

    </section>


    <!-- Services -->

    <section id="services">

        <h2>Our Services</h2>

        <div class="services-container">

            <div class="service">
                <h3>24/7 Emergency</h3>
                <p>
                    Emergency medical care available
                    around the clock.
                </p>
            </div>

            <div class="service">
                <h3>Diagnostic Services</h3>
                <p>
                    Modern diagnostic facilities for
                    accurate medical evaluation.
                </p>
            </div>

            <div class="service">
                <h3>Pharmacy</h3>
                <p>
                    Convenient access to essential
                    medicines and healthcare products.
                </p>
            </div>

        </div>

    </section>


    <!-- Appointment -->

    <section id="appointment">

        <h2>Book an Appointment</h2>

        <p class="section-intro">
            Fill in your details and our team can contact you.
        </p>

        <form id="appointmentForm">

            <input
                type="text"
                placeholder="Your Name"
                required
            >

            <input
                type="tel"
                placeholder="Phone Number"
                required
            >

            <input
                type="email"
                placeholder="Email Address"
                required
            >

            <select required>

                <option value="">
                    Select Department
                </option>

                <option>
                    Cardiology
                </option>

                <option>
                    Neurology
                </option>

                <option>
                    Orthopedics
                </option>

                <option>
                    Pediatrics
                </option>

            </select>

            <textarea
                placeholder="Message (Optional)"
            ></textarea>

            <button type="submit">
                Request Appointment
            </button>

        </form>

    </section>


    <!-- Contact -->

    <section id="contact">

        <h2>Contact Us</h2>

        <div class="contact-info">

            <p>
                📍 123 Healthcare Avenue, City
            </p>

            <p>
                📞 +91 98765 43210
            </p>

            <p>
                ✉️ care@careplushospital.com
            </p>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <p>
            © 2026 CarePlus Hospital. All Rights Reserved.
        </p>

    </footer>


    <script src="script.js"></script>

</body>

</html>
